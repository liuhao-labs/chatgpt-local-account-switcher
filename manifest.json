{
  "manifest_version": 3,
  "name": "ChatGPT 本地账号切换器",
  "version": "0.3.1",
  "author": "Hao Liu and contributors",
  "homepage_url": "https://github.com/liuhao-labs/chatgpt-local-account-switcher",
  "description": "在本机保存 ChatGPT 会话并快速切换账号。不会上传凭据。",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_title": "ChatGPT 本地账号切换器",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
